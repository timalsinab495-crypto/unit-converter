# ─────────────────────────────────────────────────────────────────────────────
# Naptaul — environment variables
#
# Some conversions never change (1 ropani = 5,476 sq ft, °F → °C).
# These ones DO change over time, so they live here instead of in the code.
#
#  • Locally:   edit this file, then restart `npm run dev`.
#  • On Vercel: this file is NOT uploaded (it's in .gitignore).
#               Add each variable in Project → Settings → Environment Variables,
#               then redeploy so the new values are picked up.
#
# If a variable is missing, the app uses a built-in fallback and writes a
# 🔑 env_fallback warning to the logs.
#
# The numbers below are sample values for class. Update them before relying
# on them for anything real.
# ─────────────────────────────────────────────────────────────────────────────

# 1 US dollar in Nepali rupees
USD_TO_NPR=141.50

# 1 Indian rupee in Nepali rupees (pegged at 1.60 since 1993)
INR_TO_NPR=1.60

# Price of 1 tola (11.664 g) of fine gold, in rupees
GOLD_PRICE_PER_TOLA_NPR=245000

# Price of 1 tola of silver, in rupees
SILVER_PRICE_PER_TOLA_NPR=3100

# Price of 1 litre of petrol, in rupees
PETROL_PRICE_PER_LITRE_NPR=157

# When the numbers above were last updated (shown on the home page)
RATES_UPDATED_ON=2026-09-24
